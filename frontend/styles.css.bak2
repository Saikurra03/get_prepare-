/* BERREADY design system — premium dark-first claymorphism
   Background: near-black charcoal #0B0C10
   Clay: soft floating panels with bottom-right + top-left shadows
   Accent: teal #14B8A6
   Dark mode is default; light mode overrides via [data-theme="light"] */
:root{
  color-scheme:dark;
  /* Core surfaces */
  --bg:#0B0C10; --bg-elevated:#171D26; --surface:#1E2530; --surface-strong:#252D3B;
  /* Clay */
  --clay-bg:rgba(11,12,16,.8); --clay-card:rgba(15,18,24,.9);
  --clay-shadow-lg:2px 4px 12px rgba(0,0,0,.4), -2px -4px 12px rgba(255,255,255,.08);
  --clay-shadow-md:1px 2px 6px rgba(0,0,0,.3), -1px -2px 6px rgba(255,255,255,.05);
  --clay-shadow-sm:0 1px 2px rgba(0,0,0,.2);
  /* Accent */
  --acc:#14B8A6; --acc-hover:#17DAB8; --acc-soft:rgba(20,184,166,.18);
  /* Text */
  --ink:#ECECF1; --ink-muted:#78A0B0; --ink-dim:#5A7C8E;
  /* Semantic */
  --ok:#10B981; --warn:#F59E0B; --bad:#EF4444;
  /* Borders & lines */
  --line:rgba(255,255,255,.1); --line-soft:rgba(255,255,255,.05);
  /* Shadows */
  --shadow-sm:0 1px 2px rgba(0,0,0,.3);
  --shadow-md:0 4px 12px rgba(0,0,0,.35);
  --shadow-lg:0 8px 24px rgba(0,0,0,.4);
  --shadow-side:2px 4px 12px rgba(0,0,0,.3);
  --shadow-top:2px 4px 12px rgba(0,0,0,.3);
  --shadow-bottom:-2px -4px 12px rgba(255,255,255,.05);
  --shadow-active:0 1px 2px rgba(0,0,0,.3),0 4px 8px rgba(0,0,0,.2);
  /* Radius */
  --radius-sm:12px; --radius-md:16px; --radius-lg:20px;
  /* Spacing */
  --space-xs:6px; --space-sm:12px; --space-md:18px; --space-lg:24px; --space-xl:32px;
  /* Sidebar */
  --side-expanded:260px; --side-collapsed:70px;
  /* Font */
  --font:"Inter","Segoe UI",system-ui,-apple-system,Arial,sans-serif;
  /* Aliases for JS inline styles */
  --good:var(--ok); --accent:var(--acc); --bg-soft:var(--surface-strong);
}

/* Light theme override */
:root[data-theme="light"]{
  color-scheme:light;
  --bg:#F5F5F7; --bg-elevated:#FFFFFF; --surface:#FFFFFF; --surface-strong:#F8F9FA;
  --clay-bg:#F5F5F7; --clay-card:#FFFFFF;
  --acc:#14B8A6; --acc-hover:#17DAB8; --acc-soft:rgba(20,184,166,.22);
  --ink:#111114; --ink-muted:#6B6B70; --ink-dim:#83838C;
  --ok:#0E9F6E; --warn:#A16207; --bad:#DC2626;
  --line:#E3E3E8; --line-soft:#ECECEF;
  --shadow-sm:0 1px 2px rgba(17,17,22,.06);
  --shadow-md:0 4px 16px rgba(17,17,22,.08);
  --shadow-lg:0 8px 32px rgba(17,17,22,.12);
  --shadow-side:4px 0 24px rgba(17,17,22,.05);
  --shadow-top:0 8px 32px rgba(17,17,22,.06);
  --shadow-bottom:0 -8px 32px rgba(17,17,22,.06);
  --shadow-active:0 1px 3px rgba(17,17,22,.14),0 6px 16px rgba(17,17,22,.06);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.55;
  -webkit-font-smoothing:antialiased}
/* ---------- shell ---------- */
.shell{display:flex;min-height:100vh}
.sidebar{width:var(--side);flex:0 0 var(--side);background:var(--clay-bg);
  border-right:1px solid var(--line);
  padding:18px 14px;position:sticky;top:0;height:100vh;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;gap:4px;
  transition:width .2s ease,padding .2s ease}
.brand{display:flex;align-items:center;gap:10px;padding:2px 8px 14px;justify-content:flex-start;
  transition:justify-content .2s ease}
.brand-mark{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--acc),var(--acc-hover));
  display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;color:#fff;flex:none}
.brand-name{font-weight:800;letter-spacing:.14em;font-size:14px}
.brand-sub{font-size:11px;color:var(--dim);letter-spacing:.02em}
.nav-sec{font-size:11px;letter-spacing:.12em;color:var(--dim);padding:12px 10px 5px;text-transform:uppercase;
  white-space:nowrap;overflow:hidden}
.nav-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:var(--radius-sm);
  color:var(--ink-muted);text-decoration:none;font-weight:600;font-size:14px;border:1px solid var(--line);
  transition:background .15s ease,color .15s ease,padding .2s ease}
.nav-item .ic{width:22px;text-align:center;opacity:.9;flex:none}
.nav-item:hover{background:var(--surface-strong);color:var(--ink);border-color:transparent}
.nav-item.active{background:var(--surface);color:var(--ink);border-color:transparent;
  box-shadow:var(--shadow-active)}
.nav-sub{padding-left:32px;font-size:13.5px}
.side-foot{margin-top:auto;padding:12px 8px 2px}
.ai-pill{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--ink-muted);
  border:var(--line);border-radius:20px;padding:6px 12px;background:var(--clay-card);
  box-shadow:var(--clay-shadow-md)}
.dot{width:9px;height:9px;border-radius:50%;background:var(--dim);flex:none}
.dot.on{background:var(--ok)} .dot.rec{background:var(--bad);animation:bl 1s infinite alternate}
@keyframes bl{to{opacity:.35}}
.main{flex:1;min-width:0;display:flex;flex-direction:column}
.topbar{display:flex;align-items:center;gap:12px;padding:14px 26px;border-bottom:1px solid var(--line);
  position:sticky;top:0;background:var(--clay-bg);
  box-shadow:var(--shadow-top);
  z-index:5}
.topbar h1{font-size:17px;margin:0;font-weight:700}
.topbar .crumb{font-size:12.5px;color:var(--dim)}
.icon-btn{background:var(--clay-card);border:var(--line);color:var(--ink);border-radius:var(--radius-sm);
  padding:7px 10px;cursor:pointer;font-size:14px;box-shadow:var(--clay-shadow-md)}
.icon-btn.theme-btn{margin-left:auto}
.content{width:100%;max-width:calc(1080px+var(--side)-256px);margin:0auto;padding:var(--space-lg)var(--space-xl)var(--space-xl)}
.bottomnav{display:none}
/* ---------- type & blocks ---------- */
h2{font-size:20px;margin:0 0 4px} h3{font-size:15.5px;margin:0 0 8px}
.sub{color:var(--mut);font-size:13.5px;margin:0 0 16px}
.grid{display:grid;gap:14px}
.g2{grid-template-columns:repeat(2,1fr)} .g3{grid-template-columns:repeat(3,1fr)}
/* Clay card: soft floating panel with layered shadows, 20px corners. */
.card{background:var(--clay-card);border-radius:var(--radius-lg);padding:16px 18px;position:relative;box-shadow:var(--clay-shadow-lg)}
.card.quiet{background:transparent}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.mt{margin-top:14px} .mb{margin-bottom:14px}
.mut{color:var(--mut)} .dim{color:var(--dim)} .small{font-size:13px}
/* ---------- controls ---------- */
button,.btn{background:var(--clay-card);color:var(--ink);border:var(--line);
  border-radius:12px;padding:9px 15px;font-weight:600;font-size:14px;cursor:pointer;
  text-decoration:none;display:inline-block;font-family:var(--font);
  box-shadow:var(--clay-shadow-md)}
button:hover,.btn:hover{background:var(--surface-strong);border-color:rgba(255,255,255,0.12)}
button.primary,.btn.primary{background:var(--acc);border-color:var(--acc);color:#fff;
  box-shadow:0 1px 2px rgba(20,184,166,.3)}
button.primary:hover,.btn.primary:hover{background:var(--acc-hover);border-color:var(--acc-hover)}
button.ghost,.btn.ghost{background:transparent;box-shadow:none;border-color:var(--line)}
button.ghost:hover,.btn.ghost:hover{background:rgba(255,255,255,.05)}
button.danger,.btn.danger{border-color:var(--bad-bd);color:var(--danger-ink);background:var(--bad-bg)}
button:disabled{opacity:.5;cursor:default}
select,input[type=text],input[type=number],textarea{background:rgba(255,255,255,.05);color:var(--ink);
  border:1px solid var(--line);border-radius:12px;padding:9px 12px;font-size:14px;font-family:var(--font);
  box-shadow:var(--clay-shadow-sm)}
select:focus,input:focus,textarea:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px var(--acc-soft)}
label.fl{display:block;font-size:12.5px;color:var(--ink-muted);margin:10px 0 4px;font-weight:600}
input[type=file]{font-size:13px;color:var(--mut)}
/* ---------- mode list / practice ---------- */
.mode{display:flex;gap:14px;align-items:flex-start;padding:15px 16px}
.mode .m-ic{width:40px;height:40px;flex:none;border-radius:11px;background:var(--tint);
  border:1px solid var(--line-soft);display:flex;align-items:center;justify-content:center;font-size:19px}
.mode h3{margin:0 0 2px} .mode p{margin:0;color:var(--mut);font-size:13.5px}
.mode .go{margin-left:auto;flex:none;align-self:center}
/* ---------- live workspace ---------- */
.live{display:grid;grid-template-columns:340px 1fr;gap:14px}
video.cam{width:100%;border-radius:var(--r);background:#000;aspect-ratio:4/3;display:block}
.statusbar{display:flex;gap:14px;align-items:center;font-size:12.5px;color:var(--mut);padding:8px 2px;flex-wrap:wrap}
.timer{font-variant-numeric:tabular-nums;color:var(--mut)}
.transcript{min-height:110px;background:var(--clay-card);border:var(--line);
  box-shadow:var(--clay-shadow-md);border-radius:12px;padding:12px;white-space:pre-wrap;font-size:14.5px}
.question{font-size:19px;font-weight:700;line-height:1.45;margin:6px 0 12px}
.feedback{white-space:pre-wrap;line-height:1.6}
.score{display:inline-block;background:var(--tint);border:1px solid var(--line);
  border-radius:8px;padding:3px 10px;font-weight:700;font-size:13px;margin:2px 6px 2px 0}
body.speaking .dim-while-speaking{opacity:.55}
.stepper{display:flex;gap:6px;margin:0 0 16px;flex-wrap:wrap}
.step{font-size:12px;font-weight:700;color:var(--dim);border:1px solid var(--line);
  padding:4px 11px;border-radius:16px;background:var(--surface)}
.step.on{color:#fff;background:var(--acc);border-color:var(--acc)}
/* ---------- buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:var(--space-sm);
  padding:var(--space-sm)var(--space-md);border-radius:var(--radius-sm);
  font-weight:600;font-size:14px;font-family:var(--font);
  background:var(--glass-card);color:var(--ink);
  border:1pxsolidvar(--glass-border);backdrop-filter:blur(var(--glass-blur));
  box-shadow:var(--shadow-sm),inset01px0var(--glass-highlight);
  transition:background.15s,ease,border-color.15s,transform.05s,box-shadow.15s}
.btn:hover{background:var(--surface-strong);border-color:rgba(255,255,255,0.12)}
.btn:active{transform:scale(.98)}
.btn:focus-visible{outline:none;box-shadow:0003pxvar(--acc-soft)}
.btn-primary{background:var(--acc);border-color:var(--acc);color:#fff}
.btn-primary:hover{background:var(--acc-hover);border-color:var(--acc-hover)}
.btn-ghost{background:transparent;box-shadow:none;border-color:var(--glass-border)}
.btn-ghost:hover{background:rgba(255,255,255,.05)}
.btn-danger{background:rgba(239,68,68,.15);border-color:rgba(239,68,68,.3);color:#FCA5A5}
.btn-sm{padding:6px12px;font-size:13px}
.btn-lg{padding:12px24px;font-size:15px}

/* Icon button */
.icon-btn{
  display:inline-flex;align-items:center;justify-content:center;
  width:40px;height:40px;border-radius:var(--radius-sm);
  background:var(--clay-card);border:var(--line);color:var(--ink);
  box-shadow:var(--clay-shadow-md)}
.icon-btn:hover{background:var(--surface-strong);border-color:rgba(255,255,255,.12)}
/* Tooltip */
.tooltip{position:relative}
.tooltip::before{
  content:attr(data-tooltip);position:absolute;bottom:100%;left:50%;transform:translateX(-50%);
  background:var(--surface-strong);border:1pxsolidvar(--glass-border);border-radius:var(--radius-sm);
  padding:var(--space-xs)var(--space-sm);font-size:12px;color:var(--ink);white-space:nowrap;
  opacity:0;pointer-events:none;box-shadow:var(--shadow-md);transition:opacity.15s,transform.15s;
  z-index:50;margin-bottom:6px}
.tooltip:hover::before{opacity:1;transform:translateX(-50%)translateY(-4px)}
.pill{font-size:12px;border:var(--line);border-radius:16px;padding:3px 11px;color:var(--ink-muted);
  background:var(--clay-card)}
.pill.ok{color:var(--ok);border-color:var(--ok-bd);background:var(--ok-bg)}
.pill.warn{color:var(--warn);border-color:var(--warn-bd);background:var(--warn-bg)}
.pill.bad{color:var(--bad);border-color:var(--bad-bd);background:var(--bad-bg)}
table.t{width:100%;border-collapse:collapse;font-size:14px}
table.t th{text-align:left;font-size:12px;color:var(--dim);font-weight:700;padding:8px 10px;
  border-bottom:1px solid var(--line-soft);text-transform:uppercase;letter-spacing:.06em}
table.t td{padding:10px;border-bottom:1px solid var(--line-soft)}
table.t tr:hover td{background:var(--hover-soft)}
a{color:var(--link)}
.kv{display:grid;grid-template-columns:170px 1fr;gap:6px 12px;font-size:14px}
.kv dt{color:var(--dim)} .kv dd{margin:0}
/* ---------- responsive ---------- */
@media(max-width:1020px){
  .live{grid-template-columns:1fr}
  .g3{grid-template-columns:repeat(2,1fr)}
  .content{padding:18px 16px 90px}
}
@media(max-width:760px){
  .sidebar{display:none}
  .g2,.g3{grid-template-columns:1fr}
  .topbar{padding:12px 14px}
  .bottomnav{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:10;background:var(--glass-chrome);
    -webkit-backdrop-filter:blur(var(--glass-blur));backdrop-filter:blur(var(--glass-blur));
    box-shadow:var(--shadow-bottom), var(--glass-rim);
    border-top:1px solid var(--glass-line);padding:6px 4px calc(6px + env(safe-area-inset-bottom))}
  .bottomnav a{flex:1;text-align:center;color:var(--mut);text-decoration:none;font-size:11px;
    font-weight:700;padding:6px 2px}
  .bottomnav a.active{color:var(--ink)}
  .bottomnav .ic{display:block;font-size:18px}
  .content{padding-bottom:calc(var(--space-xl)+env(safe-area-inset-bottom))}
}
/* ============================================================
   Sidebar collapse / expand
   ============================================================ */
body.nav-collapsed{--side:68px}
body.nav-collapsed .sidebar{width:var(--side);flex-basis:var(--side);padding:18px 0}
body.nav-collapsed .brand{justify-content:center;padding-left:0;padding-right:0}
body.nav-collapsed .nav-item{justify-content:center;padding-left:0;padding-right:0}
body.nav-collapsed .nav-item span.tx,
body.nav-collapsed .nav-sec,
body.nav-collapsed .brand-name,
body.nav-collapsed .brand-sub,
body.nav-collapsed .side-foot{display:none;opacity:0;pointer-events:none;width:0;overflow:hidden;transition:opacity .1s width .22s ease}
body.nav-collapsed .nav-sub{display:none}
body.nav-collapsed .nav-item .ic{width:auto}
.nav-item.has-sub .chevron{display:none}

/* ============================================================
   Phase 3: Full-screen mock interview environment (/mock)
   Additive only ï¿½ reuses existing tokens, no overrides.
   ============================================================ */
body.mock-root{margin:0;height:100vh;overflow:hidden;background:var(--bg);color:var(--ink);
  font-family:var(--font);-webkit-font-smoothing:antialiased}
.mock{display:flex;flex-direction:column;height:100vh}
.mock-top{display:flex;align-items:center;gap:16px;padding:10px 18px;background:var(--glass-chrome);
  -webkit-backdrop-filter:blur(var(--glass-blur));backdrop-filter:blur(var(--glass-blur));
  box-shadow:var(--shadow-top), var(--glass-rim);border-bottom:1px solid var(--glass-line);flex-wrap:wrap}
.mock-brand{font-weight:800;letter-spacing:.08em;font-size:13px;color:var(--link)}
.mock-mode{font-size:13px;color:var(--mut)}
.mock-spacer{flex:1}
.mock-timer{font-variant-numeric:tabular-nums;font-size:16px;font-weight:600}
.mock-pill{font-size:12px;color:var(--ink-muted);border:var(--line);border-radius:999px;padding:3px 10px;
  background:var(--clay-card)}
.mock-dots{display:flex;gap:5px;align-items:center}
.mock-dot{width:9px;height:9px;border-radius:50%;background:var(--dot-off);transition:.2s}
.mock-dot.done{background:var(--ok)}
.mock-dot.now{background:var(--acc);box-shadow:0 0 0 3px var(--acc-soft)}
.mock-body{flex:1;display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;
  padding:16px 18px;min-height:0;overflow:auto}
.mock-stage{background:var(--clay-card);border:var(--line);
  border-radius:var(--r);
  padding:clamp(18px,3vw,34px);display:flex;flex-direction:column;justify-content:center;min-width:0}
.mock-q-label{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--dim)}
.mock-q{font-size:clamp(20px,2.6vw,30px);line-height:1.35;margin-top:12px;font-weight:600;
  overflow-wrap:anywhere}
.mock-bridge{margin-top:14px;color:var(--ok);font-size:14px;min-height:20px}
.mock-meta{margin-top:auto;padding-top:18px;display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:var(--dim)}
.mock-side{display:flex;flex-direction:column;gap:12px;min-width:0}
.mock-video{width:100%;aspect-ratio:4/3;background:#111214;border:1px solid var(--hair-strong);
  border-radius:var(--r);object-fit:cover;transform:scaleX(-1)}
.mock-status{display:flex;gap:14px;font-size:12px;color:var(--mut);align-items:center;flex-wrap:wrap}
.mock-side-card{background:var(--clay-card);border:var(--line);border-radius:var(--r);
  padding:12px;font-size:13px;color:var(--mut);line-height:1.5}
.mock-bottom{background:var(--glass-chrome);border-top:1px solid var(--glass-line);padding:12px 18px;
  -webkit-backdrop-filter:blur(var(--glass-blur));backdrop-filter:blur(var(--glass-blur));
  box-shadow:var(--shadow-bottom), var(--glass-rim);
  display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap}
.mock-tx{flex:1;min-width:240px;min-height:74px;max-height:150px;overflow:auto;
  background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:var(--r-sm);
  padding:10px 12px;outline:none;font-size:14px;line-height:1.5;color:var(--ink)}
.mock-tx:empty:before{content:attr(data-ph);color:var(--dim)}
.mock-ctrls{display:flex;gap:8px;flex-wrap:wrap;max-width:460px;align-items:center}
.mock-foot{display:flex;gap:10px;align-items:center;padding:0 18px 12px;flex-wrap:wrap}
.mock-msg{font-size:13px;min-height:18px}
@media (max-width:900px){
  .mock-body{grid-template-columns:1fr;gap:10px;padding:10px}
  .mock-side{order:-1}
  .mock-video{max-height:180px;aspect-ratio:16/9}
  .mock-q{font-size:20px}
  .mock-bottom{padding:10px}
}

/* ============================================================
   Phase 4: Question list builder (/qbank)
   ============================================================ */
.qb-list{max-height:340px;overflow:auto;border:var(--line);border-radius:12px;
  background:var(--clay-card);padding:6px}
.qb-item{display:flex;gap:8px;padding:7px 8px;border-bottom:1px solid var(--line-soft);font-size:13px}
.qb-item:last-child{border-bottom:none}
.qb-n{color:var(--dim);min-width:26px;font-variant-numeric:tabular-nums;text-align:right}
.qb-empty{padding:14px;color:var(--dim);font-size:13px;text-align:center}
.qb-controls{display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end}
.qb-controls>div{min-width:130px}

/* ============================================================
   Phase 5: Report dashboard charts (SVG, dependency-free)
   ============================================================ */
.dash{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
.chart-svg{width:100%;height:auto;display:block}
.chart-legend{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--mut);margin-top:6px}
.chart-legend b{color:var(--ink);font-weight:600}

/* ============================================================
   Full-screen live interview room (/interview-live)
   Zoom/Meet-style: fills 100vh Ã— 100vw, no shell, no page scroll.
   ============================================================ */
body.il-root{margin:0;height:100vh;overflow:hidden;background:var(--bg);color:var(--ink);
  font-family:var(--font);-webkit-font-smoothing:antialiased}
.il{display:flex;flex-direction:column;height:100vh;width:100%}
.il-top{display:flex;align-items:center;gap:14px;padding:9px 16px;background:var(--glass-chrome);
  -webkit-backdrop-filter:blur(var(--glass-blur));backdrop-filter:blur(var(--glass-blur));
  box-shadow:var(--shadow-top), var(--glass-rim);border-bottom:1px solid var(--glass-line);flex-wrap:wrap;flex:none}
.il-brand{font-weight:800;letter-spacing:.08em;font-size:13px;color:var(--link)}
.il-mode{font-size:13px;color:var(--mut)}
.il-spacer{flex:1}
.il-pill{font-size:12px;color:var(--ink-muted);border:var(--line);border-radius:999px;
  padding:3px 10px;white-space:nowrap;font-variant-numeric:tabular-nums;background:var(--clay-card)}
.il-timer{font-size:15px;font-weight:600;color:var(--ink)}
.il-body{flex:1;min-height:0;display:grid;
  grid-template-columns:minmax(0,1fr) clamp(250px,23vw,350px);gap:16px;padding:16px 18px;overflow:hidden}
.il-stage{background:var(--clay-card);border:var(--line);
  border-radius:var(--r);
  padding:clamp(18px,3vw,36px);display:flex;flex-direction:column;min-width:0;overflow:auto}
.il-q-label{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--dim);flex:none}
.il-q{font-size:clamp(20px,2.4vw,30px);line-height:1.35;font-weight:600;margin-top:12px;
  overflow-wrap:anywhere;flex:none}
.il-bridge{margin-top:12px;color:var(--ok);min-height:20px;flex:none}
.il-read{margin-top:16px;gap:8px;flex:none}
.il-meta{margin-top:auto;padding-top:16px;font-size:12.5px;color:var(--dim);flex:none}
.il-side{display:flex;flex-direction:column;gap:12px;min-width:0;overflow:auto}
.il-video{width:100%;aspect-ratio:4/3;max-height:38vh;object-fit:cover;background:#111214;
  border:1px solid var(--hair-strong);border-radius:var(--r);transform:scaleX(-1);flex:none}
.il-hint{background:var(--clay-card);border:var(--line);border-radius:var(--r);
  padding:11px 12px;font-size:13px;color:var(--mut);line-height:1.5}
.il-bottom{background:var(--glass-chrome);border-top:1px solid var(--glass-line);padding:10px 18px 12px;
  -webkit-backdrop-filter:blur(var(--glass-blur));backdrop-filter:blur(var(--glass-blur));
  box-shadow:var(--shadow-bottom), var(--glass-rim);
  display:flex;flex-direction:column;gap:8px;flex:none}
.il-ansrow{display:flex;gap:16px;align-items:stretch;flex-wrap:wrap}
.il-ans{flex:1;min-width:280px;display:flex;flex-direction:column;gap:6px;min-width:0}
.il-tx{flex:1;min-height:64px;max-height:24vh;overflow:auto;background:var(--glass-input);
  border:1px solid var(--hair);border-radius:var(--r-sm);padding:10px 12px;outline:none;
  -webkit-backdrop-filter:blur(var(--glass-blur));backdrop-filter:blur(var(--glass-blur));
  font-size:14.5px;line-height:1.5;white-space:pre-wrap;color:var(--ink)}
.il-tx:focus{border-color:var(--acc)}
.il-ctrls{display:flex;gap:8px;flex-wrap:wrap;align-items:center;align-content:flex-start;
  max-width:520px}
.il-status{display:flex;gap:16px;min-height:20px;flex-wrap:wrap;align-items:center}
@media (max-width:980px){
  .il-body{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);gap:10px;padding:10px}
  .il-side{order:-1;flex-direction:row;flex-wrap:wrap;align-items:center;overflow:visible}
  .il-video{max-height:150px;width:auto;aspect-ratio:16/9;flex:none}
  .il-hint{display:none}
  .il-stage{padding:16px}
  .il-q{font-size:20px}
  .il-bottom{padding:10px}
  .il-ctrls{max-width:none}
}

/* ============================================================
   Compact results screen (/result)
   ============================================================ */
.g4{grid-template-columns:repeat(4,1fr)}
.res-hero{display:flex;align-items:center;gap:24px;flex-wrap:wrap}
.res-score{font-size:58px;font-weight:800;line-height:1;letter-spacing:-.02em;white-space:nowrap}
.res-of{font-size:16px;font-weight:600;color:var(--ink-muted);margin-left:3px;letter-spacing:0}
.res-meter{flex:1;min-width:220px;display:flex;flex-direction:column;gap:8px}
.meter{height:9px;border-radius:99px;background:var(--track);overflow:hidden;
  border:1px solid var(--line)}
.meter>i{display:block;height:100%;border-radius:99px;
  background:linear-gradient(90deg,var(--acc),var(--acc-soft))}
.res-tile .k{font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-muted);
  font-weight:700;margin-bottom:6px}
.res-tile .v{font-size:27px;font-weight:800;line-height:1.1;margin-bottom:4px}
.res-list{margin:6px 0 0;padding-left:18px}
.res-list li{margin:5px 0;font-size:14px}
.chips{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
@media (max-width:980px){
  .g4{grid-template-columns:repeat(2,1fr)}
  .res-score{font-size:46px}
}
@media (max-width:560px){
  .g4{grid-template-columns:1fr}
}

/* ============================================================
   Glass fallbacks â€” no backdrop-filter support, or the user
   asked the OS for reduced transparency â†’ solid white surfaces.
   ============================================================ */
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  .sidebar,.topbar,.bottomnav,.mock-top,.mock-bottom,.il-top,.il-bottom{
    -webkit-backdrop-filter:none;backdrop-filter:none;background:var(--solid)}
  .card,.mock-stage,.mock-side-card,.il-stage,.il-hint,.qb-list,.transcript,
  button,.btn,.icon-btn,.ai-pill,.pill,.mock-pill,.il-pill{
    -webkit-backdrop-filter:none;backdrop-filter:none;background:var(--solid-strong)}
}
@media (prefers-reduced-transparency:reduce){
  .sidebar,.topbar,.bottomnav,.mock-top,.mock-bottom,.il-top,.il-bottom,
  .card,.mock-stage,.mock-side-card,.il-stage,.il-hint,.qb-list,.transcript,
  button,.btn,.icon-btn,.ai-pill,.pill,.mock-pill,.il-pill{
    -webkit-backdrop-filter:none;backdrop-filter:none;background:var(--surface)}
}

/* ============================================================
   Phase 6: Responsive & Accessibility
   ============================================================ */
@media (min-width:1200px){.live{grid-template-columns:360px 1fr}}
@media (min-width:1440px){.live{grid-template-columns:400px 1fr}}

:focus-visible{outline:none;box-shadow:0 0 0 3px var(--acc-soft)}
button:focus-visible, .btn:focus-visible, .icon-btn:focus-visible{outline:none;box-shadow:0 0 0 3px var(--acc-soft)}

nav .nav-item,[role="navigation"] .nav-item{position:relative}
nav .nav-item[aria-current],nav .nav-item:focus-visible::before{
  content:"";position:absolute;left:0;width:4px;height:100%;background:var(--acc);border-radius:2px 2px 0 0}
nav .nav-item:focus-visible{outline:none;background:var(--surface);color:var(--ink)}

@media (prefers-reduced-motion:reduce){
  *, *::before, *::after{
    animation-duration:0ms !important;transition-duration:0ms !important}
  body.nav-collapsed .nav-item span.tx,
  body.nav-collapsed .nav-sec,
  body.nav-collapsed .brand-name,
  body.nav-collapsed .brand-sub,
  body.nav-collapsed .side-foot{
    opacity:1;pointer-events auto;width:auto;transition:none}
  .mock-dot,.mock-dot.done,.mock-dot.now{transition:none}
}


# BeReady Boy — copy to .env and fill in. NEVER commit .env. Keys stay server-side only.
# Add as many numbered keys as you have; rotation is automatic, no code changes needed.
# Order per provider: _1, _2, ... then legacy single key (if set).

# Gemini keys (https://aistudio.google.com/apikey)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# GEMINI_API_KEY=   # legacy single key, still supported as an extra rotation slot

# Groq keys (https://console.groq.com/keys)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# GROQ_API_KEY=   # legacy single key, still supported as an extra rotation slot

# OpenRouter keys (https://openrouter.ai/keys) — OPENROUTER_API_KEY_* or openrouter_api_key*
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

# Cohere keys (https://dashboard.cohere.com/api-keys) — COHERE_API_KEY_* or cohere_api_key*
COHERE_API_KEY_1=
COHERE_API_KEY_2=

# Model configuration (replaceable, no hardcoded outdated names elsewhere).
# Verified live Sep 2026 via API probes: Gemini 3.5 series, Groq GPT-OSS series.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
COHERE_MODEL=command-r
COHERE_FALLBACK_MODEL=command-r-plus

# Rotation strategy: providers tried in this order, keys _1.._N inside each provider.
AI_PROVIDER_ORDER=gemini,groq,openrouter,cohere
# Hard cap on attempts per request (each key tried at most once — no infinite loops).
AI_MAX_ATTEMPTS=12
# Cooldown for a rate-limited key (seconds); doubles per consecutive failure, max 900s.
AI_KEY_COOLDOWN_SECONDS=60
# Cooldown for an invalid/unauthorized key (seconds).
AI_INVALID_KEY_COOLDOWN_SECONDS=1800
# Backoff sleep between attempts in-request (ms, exp. growth, capped 1000ms). 0 = off.
AI_RETRY_BASE_MS=150
AI_TIMEOUT_SECONDS=30

# Storage
DATA_DIR=backend/data

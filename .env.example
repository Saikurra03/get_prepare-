# BeReady Boy — copy to .env and fill in. NEVER commit .env. Keys stay server-side only.
# Add as many numbered keys as you have; rotation is automatic, no code changes needed.
# Order per provider: _1, _2, ... then legacy single key (if set).

# ElevenLabs TTS (https://elevenlabs.io) — key stays server-side only.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Gemini keys (https://aistudio.google.com/apikey)
GEMINI_API_KEY_1=your_gemini_key_1_here
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Groq keys (https://console.groq.com/keys)
GROQ_API_KEY_1=your_groq_key_1_here
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# OpenRouter keys (https://openrouter.ai/keys)
OPENROUTER_API_KEY_1=your_openrouter_key_1_here
# OPENROUTER_API_KEY_2=

# Cohere keys (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY_1=your_cohere_key_1_here
# COHERE_API_KEY_2=

# Model configuration (verified live Sep 2026)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
COHERE_MODEL=command-r
COHERE_FALLBACK_MODEL=command-r-plus

# STT Configuration (Groq Whisper)
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo

# Rotation strategy
AI_PROVIDER_ORDER=gemini,groq,openrouter,cohere
AI_MAX_ATTEMPTS=12
AI_KEY_COOLDOWN_SECONDS=60
AI_INVALID_KEY_COOLDOWN_SECONDS=1800
AI_RETRY_BASE_MS=150
AI_TIMEOUT_SECONDS=30

# Storage
DATA_DIR=backend/data

# CORS — allowed origins (comma-separated, use * for dev)
CORS_ORIGINS=*

# Backend URL (for reference, not used by the backend itself)
# BACKEND_URL=https://your-backend-domain.com
